# Dependencies
node_modules/
package-lock.json

# Build outputs
build/
dist/
dist-sapir/

# Whitelabel generated files (regenerated by build script)
whitelabels/*/generated/

# Whitelabel temp build config
whitelabel-build-config.json

# Splash backup created during whitelabel builds
src/renderer/splash.html.kolbo-original

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
.cache/

# Environment files (if you create them later)
.env
.env.local

# Auto-generated build environment config (created during builds)
src/renderer/build-env.js
nul

# Code signing certificates (NEVER commit!)
certs/
*.pfx
*.p12
*.pem

# Claude settings (may contain tokens)
.claude/settings.local.json
temp-icons/
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
resources/kolbo-cli.exe

# Project documentation (may contain secrets/API keys)
CLAUDE.md
